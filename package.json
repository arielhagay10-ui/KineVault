{
  "name": "kinevault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:media": "playwright test --config playwright.media.config.ts",
    "render:once": "node scripts/render-worker.mjs --once",
    "render:worker": "node scripts/render-worker.mjs --loop",
    "render:refresh": "node scripts/refresh-renders.mjs",
    "notify:once": "node scripts/notification-worker.mjs --once",
    "notify:worker": "node scripts/notification-worker.mjs --loop",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/test-database.mjs",
    "db:benchmark": "node scripts/test-database.mjs --benchmark",
    "db:types": "node scripts/generate-database-types.mjs",
    "setup:admin": "node scripts/bootstrap-local-admin.mjs",
    "test:worker": "node --test scripts/lib/*.test.mjs",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "prepare:anatomy": "node scripts/prepare-anatomy.mjs",
    "test:readiness": "playwright test --config playwright.readiness.config.ts",
    "performance:calibrate": "node scripts/calibrate-device-budgets.mjs",
    "deployment:check": "node scripts/check-deployment.mjs",
    "db:load": "node scripts/test-database.mjs --load --migrations",
    "db:load:http": "node scripts/test-database.mjs --http --migrations",
    "test:hardware": "playwright test --config playwright.hardware.config.ts",
    "test:firefox": "node scripts/check-firefox.mjs",
    "operations:check": "node scripts/check-operations.mjs",
    "recovery:database": "node scripts/drill-database-recovery.mjs",
    "recovery:storage": "node scripts/drill-storage-recovery.mjs"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ffmpeg-static": "5.3.0",
    "next": "16.3.6",
    "overlayscrollbars": "^2.16.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "puppeteer-core": "^25.12.0",
    "shadcn": "^4.21.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
