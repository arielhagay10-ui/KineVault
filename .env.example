NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Enable after configuring the Google provider in Supabase. Server-only flag.
AUTH_GOOGLE_ENABLED=false
# Supabase CLI Google credentials, loaded through its environment. Never public.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Optional internal URL for server-side Docker requests, for example http://host.docker.internal:15421.
SUPABASE_URL_INTERNAL=
SUPABASE_SERVICE_ROLE_KEY=
RENDER_WORKER_TOKEN=
RENDER_APP_URL=http://127.0.0.1:3000
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
